{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Load the KWin scripting API declarations from the local kwin-ts package
    // (kwin-ts/index.d.ts, discovered via its package.json "types" field).
    "typeRoots": ["."],
    "types": ["kwin-ts"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
