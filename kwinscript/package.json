{
  "name": "kwinscript",
  "version": "0.1.0",
  "private": true,
  "description": "KWin scripting bundle for kwin-api-server, built with esbuild into a single JS file",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.build.mjs",
    "build:watch": "node esbuild.build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
